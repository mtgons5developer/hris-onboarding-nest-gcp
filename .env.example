# Copy to `.env` (repo root) and `apps/api/.env`.
# Never commit real secrets.

NODE_ENV=development
PORT=3000
# Local Vite. Pages custom domains + *.hris-{admin,onboarding}.pages.dev previews are always allowed in Nest.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Docker Compose Postgres (Phase 0)
DATABASE_URL=postgresql://hris:hris@localhost:5432/hris_lab?schema=public

# Local demo without an IdP — localhost Vite only. Nest ignores bypass unless Host is localhost.
AUTH_DEV_BYPASS=true

# OIDC — Cognito lab pool (applied). JwtAuthGuard verifies JWKS (Hosted UI on public Pages).
# Keycloak stays in Compose for local password grant — add as a second comma-separated issuer/JWKS pair.
OIDC_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_Z0Q7ukIMG,http://localhost:8082/realms/hris
OIDC_JWKS_URI=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_Z0Q7ukIMG/.well-known/jwks.json,http://localhost:8082/realms/hris/protocol/openid-connect/certs
# Cognito access tokens use the app client id (`client_id`). ID tokens use `aud`.
# Keycloak access tokens use `azp` / `aud: account`. Include both IdPs' public clients.
OIDC_AUDIENCE=604evnknhtitgpltjdo90ghm7l,4ij7jqehds0m6s1ubss1aj7710,hris-web,hris-mobile,account
OIDC_CLIENT_ID=604evnknhtitgpltjdo90ghm7l
OIDC_TOKEN_URL=https://hris-lab-mtgons5.auth.ap-southeast-1.amazoncognito.com/oauth2/token
# Keycloak Compose stand-in:
# OIDC_TOKEN_URL=http://localhost:8082/realms/hris/protocol/openid-connect/token

# Keycloak Compose fallback (if you stay on local IdP instead of Cognito):
# OIDC_ISSUER=http://localhost:8082/realms/hris
# OIDC_JWKS_URI=http://localhost:8082/realms/hris/protocol/openid-connect/certs
# OIDC_AUDIENCE=
# OIDC_CLIENT_ID=hris-web

# Document storage (Phase 2)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=../../data/uploads
GCS_BUCKET=
GCS_SIGNED_URL_TTL_SECONDS=900

# Optional production email (Phase 4 — console stub if unset)
NOTIFICATION_DRIVER=console
SENDGRID_API_KEY=

# Soft multi-tenant lab default (Phase 4 optional)
DEFAULT_TENANT_ID=1

# Lab public origin (Cloudflare Tunnel) — $APEX = getlakbay.com. See docs/PRODUCTION_CLOUDFLARE.md
# Pages builds bake VITE_API_BASE_URL=https://api.getlakbay.com (not VITE_API_URL).
# AUTH_DEV_BYPASS=true is local-only: JwtAuthGuard ignores it unless Host is localhost.
# Public Pages use Cognito Hosted UI. Restart Nest after pulling the guard change.
# API public host: https://api.getlakbay.com
