# Local. Name is VITE_API_BASE_URL — not VITE_API_URL.
VITE_API_BASE_URL=http://localhost:3000
# Cloudflare Pages (both projects, Production). Vite bakes this at `npm run build`; Redeploy after changing.
# VITE_API_BASE_URL=https://api.getlakbay.com

# Luis seed button: localhost Vite only. Public Pages never shows it.
VITE_AUTH_DEV_BYPASS=true

# Cognito Hosted UI (authorization code + PKCE). Public client id is not a secret.
VITE_OIDC_CLIENT_ID=604evnknhtitgpltjdo90ghm7l
VITE_OIDC_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_Z0Q7ukIMG
VITE_OIDC_AUTHORIZE_URL=https://hris-lab-mtgons5.auth.ap-southeast-1.amazoncognito.com/oauth2/authorize
VITE_OIDC_TOKEN_URL=https://hris-lab-mtgons5.auth.ap-southeast-1.amazoncognito.com/oauth2/token
VITE_OIDC_LOGOUT_URL=https://hris-lab-mtgons5.auth.ap-southeast-1.amazoncognito.com/logout

# Post-sign-out redirect (production Cognito logout_uri only). Localhost admin/onboarding always use :5175
# (run `npm run dev:landing`); VITE_LANDING_URL is ignored on localhost.
VITE_LANDING_URL=https://getlakbay.com

# Local Keycloak password-grant fallback (localhost "Sign in with Keycloak" only).
# Defaults match Compose (`docker compose up keycloak`). Do not point these at Cognito —
# Cognito /oauth2/token rejects grant_type=password (400 unsupported_grant_type).
# VITE_KEYCLOAK_TOKEN_URL=http://localhost:8082/realms/hris/protocol/openid-connect/token
# VITE_KEYCLOAK_CLIENT_ID=hris-web
