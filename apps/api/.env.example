DATABASE_URL=postgresql://hris:hris@localhost:5432/hris_lab?schema=public
PORT=3000
# Keep true locally so localhost Vite / Playwright seed tokens still work.
# Nest ignores bypass unless Host is localhost (public tunnel requires Cognito JWTs).
AUTH_DEV_BYPASS=true
# Local Vite. Nest also always allows admin/onboarding.getlakbay.com and the two Pages.dev hosts.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=../../data/uploads
OIDC_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_Z0Q7ukIMG
OIDC_JWKS_URI=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_Z0Q7ukIMG/.well-known/jwks.json
# Web + mobile public clients. JwtAuthGuard accepts either (access `client_id` or ID `aud`).
OIDC_AUDIENCE=604evnknhtitgpltjdo90ghm7l,4ij7jqehds0m6s1ubss1aj7710
OIDC_CLIENT_ID=604evnknhtitgpltjdo90ghm7l
OIDC_TOKEN_URL=https://hris-lab-mtgons5.auth.ap-southeast-1.amazoncognito.com/oauth2/token
