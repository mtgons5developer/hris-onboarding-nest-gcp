# Copy to `.env` (repo root) and `apps/api/.env`.
# Never commit real secrets.

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Docker Compose Postgres (Phase 0)
DATABASE_URL=postgresql://hris:hris@localhost:5432/hris_lab?schema=public

# Local demo without a Firebase project (Phase 1)
AUTH_DEV_BYPASS=true

# Firebase Admin (leave empty for local bypass)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Document storage (Phase 2)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=../../data/uploads
GCS_BUCKET=
GCS_SIGNED_URL_TTL_SECONDS=900

# Optional production email (Phase 4 — console stub if unset)
NOTIFICATION_DRIVER=console
SENDGRID_API_KEY=

# Soft multi-tenant lab default (Phase 4 optional)
DEFAULT_TENANT_ID=1
